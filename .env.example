# Environment Configuration for Newfeed Community Platform

# General
ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=newfeed
DB_MAX_CONNECTIONS=25

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Object Storage
# local: store objects on server filesystem.
# r2: store objects in Cloudflare R2 through S3-compatible API.
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_ROOT=/var/lib/newfeed/objects
MEDIA_BUCKET=community-news
MEDIA_PUBLIC_URL=http://localhost:8008

# Cloudflare R2. Do not commit real values.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET=newfeed-media
R2_PUBLIC_URL=
CLOUDFLARE_API_TOKEN=<cloudflare-api-token>

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=newfeed

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production-12345678
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Service Ports
API_GATEWAY_PORT=8000
AUTH_SERVICE_PORT=50051
AUTH_SERVICE_HTTP_PORT=8001
USER_SERVICE_PORT=50052
USER_SERVICE_HTTP_PORT=8002
NEWS_SERVICE_PORT=50053
NEWS_SERVICE_HTTP_PORT=8003
SEARCH_SERVICE_PORT=50056
SEARCH_SERVICE_HTTP_PORT=8004
CHAT_SERVICE_PORT=50054
CHAT_SERVICE_HTTP_PORT=8005
MEDIA_SERVICE_PORT=50057
MEDIA_SERVICE_HTTP_PORT=8006
NOTIFICATION_SERVICE_PORT=50055
ANALYTICS_SERVICE_PORT=50058
ANALYTICS_SERVICE_HTTP_PORT=8007

# External Ports
DB_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
ELASTICSEARCH_PORT=9200
